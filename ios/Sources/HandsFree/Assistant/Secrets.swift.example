// Copy this file to Secrets.swift (git-ignored — see .gitignore) and fill in the real
// value, matching whatever CLIENT_SHARED_SECRET is set to on the backend (see
// backend/README.md and docs/risk-assessment.md for why this exists). CI generates the
// real Secrets.swift itself from a GitHub Actions secret — see
// .github/workflows/ios-sideload-build.yml — so this manual step is only needed for
// local/interactive builds on a real Mac.
//
// Named .swift.example, not .swift.example.swift or Secrets.example.swift, so
// XcodeGen/Xcode never tries to compile this template itself (it would collide with
// the real Secrets.swift's declaration of `Secrets`).
enum Secrets {
    static let clientSharedSecret = "REPLACE_WITH_REAL_SECRET"
}
