# macOS
.DS_Store

# Xcode / iOS (generated by XcodeGen from ios/project.yml — do not commit)
ios/*.xcodeproj
ios/*.xcworkspace
ios/build/
ios/DerivedData/
ios/.swiftpm/
**/xcuserdata/
*.xcuserstate

# Swift Package Manager
.build/

# Node / backend
node_modules/
backend/dist/
backend/.wrangler/

# Secrets — never commit real keys
.env
.env.*
backend/.dev.vars
!backend/.dev.vars.example
ios/Sources/HandsFree/Assistant/Secrets.swift
!ios/Sources/HandsFree/Assistant/Secrets.swift.example

# Editor
.vscode/
*.log
